# name: test/sql/explain_classifier.test
# description: SHAP for a classifier (per-class) + robustness to an invalid model
# group: [vgi_explain]

require-env VGI_EXPLAIN_WORKER

statement ok
LOAD vgi;

statement ok
SET autoinstall_known_extensions=1;

statement ok
SET autoload_known_extensions=1;

statement ok
INSTALL parquet;

statement ok
LOAD parquet;

statement ok
ATTACH 'explain' AS explain (TYPE vgi, LOCATION '{VGI_EXPLAIN_WORKER}');

statement ok
CREATE TEMP VIEW models AS SELECT * FROM read_parquet('test/fixtures/models.parquet');

statement ok
CREATE TEMP VIEW feats AS SELECT * FROM read_parquet('test/fixtures/features.parquet');

statement ok
SET VARIABLE c = (SELECT model FROM models WHERE name = 'rf_clf');

# ---- a binary tree classifier explains per class: 60 rows x 3 feats x 2 classes ----
query I
SELECT count(*) FROM explain.shap_values((SELECT * FROM feats), model := getvariable('c'), id := 'id');
----
360

# the class column is populated for a classifier
query T
SELECT DISTINCT class FROM explain.shap_values((SELECT * FROM feats), model := getvariable('c'), id := 'id')
ORDER BY class;
----
0
1

# feature_importance still ranks the informative feature first
query TI
SELECT feature, rank FROM explain.feature_importance((SELECT * FROM feats), model := getvariable('c'), id := 'id')
ORDER BY rank
LIMIT 1;
----
signal	1

# shap_base_value for a binary tree classifier: one row per class
query I
SELECT count(*) FROM explain.shap_base_value(model := getvariable('c'));
----
2

# ---- composed: SHAP additivity. base_value + sum(shap) per class reproduces the
# RandomForest's predict_proba, so the reconstructed class-1 probabilities are the
# forest's vote shares (multiples of 0.04 for 25 trees); the least certain rows sit
# 0.38 from 0.5, and 30 of 60 rows reach 0.5.
query IR
SELECT c.id, round(b.base_value + c.total_shap, 4) AS predicted_proba
FROM (SELECT id, class, sum(shap_value) AS total_shap
      FROM explain.shap_values((SELECT * FROM feats), model := getvariable('c'), id := 'id')
      GROUP BY id, class) AS c
JOIN explain.shap_base_value(model := getvariable('c')) AS b ON c.class IS NOT DISTINCT FROM b.class
WHERE c.class = '1'
ORDER BY round(abs(b.base_value + c.total_shap - 0.5), 4), c.id
LIMIT 5;
----
15	0.12
31	0.88
11	0.08
24	0.08
27	0.08

query I
SELECT count(*) FILTER (WHERE b.base_value + c.total_shap >= 0.5)
FROM (SELECT id, class, sum(shap_value) AS total_shap
      FROM explain.shap_values((SELECT * FROM feats), model := getvariable('c'), id := 'id')
      GROUP BY id, class) AS c
JOIN explain.shap_base_value(model := getvariable('c')) AS b ON c.class = b.class
WHERE c.class = '1';
----
30

# ---- composed: global rank vs dominant local driver. signal dominates every row.
query TII
WITH dominant AS (
  SELECT id, arg_max(feature, abs(shap_value)) AS feature
  FROM explain.shap_values((SELECT * FROM feats), model := getvariable('c'), id := 'id')
  WHERE class = '1' GROUP BY id)
SELECT g.feature, g.rank, count(d.id) AS rows_dominated
FROM explain.feature_importance((SELECT * FROM feats), model := getvariable('c'), id := 'id') AS g
LEFT JOIN dominant AS d ON d.feature = g.feature
GROUP BY g.feature, g.rank
ORDER BY g.rank;
----
signal	1	60
noise_b	2	0
noise_a	3	0

# the second-ranked feature pushes toward class 1 in 34 of the 60 rows
query I
SELECT count(*)
FROM explain.shap_values((SELECT * FROM feats), model := getvariable('c'), id := 'id') AS s
JOIN explain.feature_importance((SELECT * FROM feats), model := getvariable('c'), id := 'id') AS g
  ON g.feature = s.feature AND g.rank = 2
WHERE s.class = '1' AND s.shap_value > 0;
----
34

# ---- composed: drill into the top-ranked feature, raw value looked up via UNPIVOT
query ITRR
SELECT s.id, s.feature, round(f.value, 4) AS feature_value, round(s.shap_value, 4) AS shap_value
FROM explain.shap_values((SELECT * FROM feats), model := getvariable('c'), id := 'id') AS s
JOIN explain.feature_importance((SELECT * FROM feats), model := getvariable('c'), id := 'id') AS g
  ON g.feature = s.feature AND g.rank = 1
JOIN (UNPIVOT (SELECT id, signal, noise_a, noise_b FROM feats) ON signal, noise_a, noise_b INTO NAME feature VALUE value) AS f
  ON f.id = s.id AND f.feature = s.feature
WHERE s.class = '1' ORDER BY s.shap_value DESC, s.id LIMIT 3;
----
53	signal	1.0066	0.4225
40	signal	0.9874	0.4205
54	signal	0.9871	0.4188

# ---- robustness: a garbage model BLOB yields a clear error, never a crash ----
statement ok
SET VARIABLE bad = 'not-a-model'::BLOB;

statement error
SELECT * FROM explain.shap_values((SELECT * FROM feats), model := getvariable('bad'), id := 'id');
----
invalid model

statement error
SELECT * FROM explain.shap_base_value(model := getvariable('bad'));
----
invalid model

# ---- missing model argument -> clear error ----
statement error
SELECT * FROM explain.shap_base_value();
----
requires 'model'

statement ok
DETACH explain;
